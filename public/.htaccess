# ==============================================================================
# OTPPro Platform - Public Web Root Apache Configuration
# ==============================================================================
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent directory indexing
    Options -Indexes -MultiViews

    # Pass existing files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Handle /install and /install/
    RewriteRule ^install/?$ install/index.php [L,QSA]
    RewriteRule ^install/(.*)$ install/$1 [L,QSA]

    # Pass other existing directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other URLs to the Front Controller
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
