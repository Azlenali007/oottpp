# ==============================================================================
# OTPPro Platform - Environment Configuration Blueprint
# ==============================================================================

# Application Settings
APP_NAME="OTPPro"
APP_ENV="production"
APP_DEBUG=false
APP_URL="http://localhost:3000"
APP_TIMEZONE="UTC"
APP_CURRENCY="INR"
APP_CURRENCY_SYMBOL="₹"

# Super Admin CLI Setup Credentials
# (Used solely by database/seed_super_admin.php during initial bootstrapping)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@otppro.local"
SUPER_ADMIN_PASSWORD="ChangeThisPassword123!"

# MySQL 8+ Database Connection
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="otppro_db"
DB_USERNAME="otppro_user"
DB_PASSWORD="your_strong_database_password_here"
DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"

# SQLite Testing Database (for offline CLI unit testing)
DB_SQLITE_PATH="storage/database/otppro_testing.sqlite"

# Session Security
SESSION_SECURE=false # Set to true in production with HTTPS
SESSION_LIFETIME=86400
SESSION_COOKIE_SAMESITE="Strict"

# Primary OTP Service Provider API Integration
# Modular integration via modules/Providers/
OTP_PROVIDER_DEFAULT="smspool"
OTP_PROVIDER_API_KEY=""
OTP_PROVIDER_BASE_URL="https://api.provider.com/v1"
OTP_PROVIDER_WEBHOOK_SECRET=""
OTP_PROVIDER_SYNC_INTERVAL_MINUTES=15

# Payment Gateway Configuration
# Modular integration via modules/Payments/
PAYMENT_GATEWAY_DEFAULT="upi_gateway"
PAYMENT_GATEWAY_MERCHANT_ID=""
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# WebSocket Real-Time Server Configuration
WS_HOST="0.0.0.0"
WS_PORT=8080
WS_PUBLIC_URL="ws://localhost:8080"
WS_JWT_SECRET="generate_a_secure_random_64_char_secret_key"

# Cron Job Locks & Safety Settings
CRON_LOCK_TIMEOUT_SECONDS=600
CRON_ORDER_EXPIRATION_MINUTES=15
CRON_MAX_BATCH_SIZE=100
